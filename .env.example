# Copy to .env and adjust. Every value has a development default in docker-compose.yml.
DB_PASSWORD=campus
JWT_SECRET=replace-this-with-a-long-random-secret-of-at-least-32-bytes
CAMPUS_TIMEZONE=UTC
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin12345
# log (print emails to the backend log) or smtp
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_CURRENCY=USD
